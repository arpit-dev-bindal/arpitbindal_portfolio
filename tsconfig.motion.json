{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "react",
      "react-dom"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/motion/**/*.ts",
    "src/motion/**/*.tsx",
    "src/site/**/*.ts",
    "src/site/**/*.tsx"
  ]
}
